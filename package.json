{
  "name": "war-animation-library",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Data-driven interactive web animations for historical campaigns.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "serve:dist": "node scripts/serve-dist.mjs",
    "preview:local": "node scripts/deploy-local-preview.mjs",
    "check:asset-boundary": "node tools/check-git-asset-boundary.mjs",
    "assets:models:ensure": "node scripts/ensure-segmentation-models.mjs",
    "assets:britain-air:build": "node scripts/build-britain-air-unit-icons.mjs",
    "assets:britain-air:comfy": "python3 scripts/run-comfyui-air-source-pass.py",
    "assets:britain-air:comfy:apply": "python3 scripts/run-comfyui-air-source-pass.py --apply",
    "assets:britain-air:comfy-source": "python3 scripts/run-comfyui-air-source-pass.py",
    "assets:britain-air:comfy-flight": "python3 scripts/run-comfyui-air-source-pass.py --flight-state",
    "assets:britain-air:comfy-flight:apply": "python3 scripts/run-comfyui-air-source-pass.py --flight-state --apply",
    "assets:britain-air:comfy-deprecated-cutout": "python3 scripts/run-comfyui-air-unit-style-pass.py",
    "animation:workflow": "node tools/animation-assistant-workflow/run-workflow.mjs",
    "animation:visual-evidence": "node tools/tactical-terrain-studio/capture-runtime-visual-evidence.mjs",
    "animation:first-draft": "node tools/tactical-terrain-studio/run-animation-first-draft.mjs",
    "terrain:pipeline": "node tools/tactical-terrain-studio/run-terrain-pipeline.mjs",
    "terrain:britain-air:gis": "python3 scripts/derive-britain-air-terrain-gis.py",
    "terrain:studio": "node tools/tactical-terrain-studio/tactical-terrain-studio.mjs",
    "terrain:assets": "python3 tools/tactical-terrain-studio/unit-asset-package.py",
    "terrain:units": "node tools/tactical-terrain-studio/terrain-unit-layer.mjs",
    "prototype:web3d:prepare": "node tools/tactical-terrain-studio/prepare-web3d-prototype.mjs",
    "test:smoke": "playwright test"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "lucide-react": "^0.545.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.184.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.10"
  }
}
