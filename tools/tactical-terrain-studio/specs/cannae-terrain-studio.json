  "unitDensityStrategy": {
    "preserveIndependentControl": true,
    "controlContract": [
      "LOD changes only visual representation density; every tactical unit keeps its own logical route, heading, visibility window, and faction identity.",
      "Formation clusters are temporary visual grouping surfaces for readability, not a return to block movement.",
      "At close-contact stages, render front-rank and edge units with detailed billboards, use staggered depth and lighter rear-rank tokens for interior units, and keep contact/effect anchors tied to actual opposing unit positions.",
      "Winner and remnant result units stay visible; LOD must not hide the victorious Carthaginian field presence."
    ],
    "stageStrategies": [
      {
        "stageId": "deployment",
        "mode": "independent-visible-units-with-depth-stagger",
        "maxVisibleInstances": 70,
        "clusterPolicy": "none",
        "purpose": "Show Roman depth without turning the opening into a solid carpet."
      },
      {
        "stageId": "contact",
        "mode": "front-rank-detail-plus-rear-rank-lod",
        "maxVisibleInstances": 86,
        "clusterPolicy": "center infantry rear ranks use low-contrast tokens while contact files remain detailed",
        "purpose": "Keep the first collision readable while preserving Roman pressure and Carthaginian yield."
      },
      {
        "stageId": "pocket",
        "mode": "formation-cluster-lod-with-independent-edge-units",
        "maxVisibleInstances": 96,
        "clusterPolicy": "interior units aggregate visually; wing edges and contact units remain individual",
        "purpose": "Avoid fog-like density while showing the bag forming and flank pressure."
      },
      {
        "stageId": "rearSeal",
        "mode": "independent-cavalry-billboards",
        "maxVisibleInstances": 34,
        "clusterPolicy": "none",
        "purpose": "Cavalry rear closure must read as mobile units, not a stripe."
      },
      {
        "stageId": "compression",
        "mode": "multi-ring-pressure-lod",
        "maxVisibleInstances": 104,
        "clusterPolicy": "Roman remnants are broken visible subgroups; Carthaginian inner ring and cavalry seal keep individual edge units",
        "purpose": "Show pressure, elasticity, and collapse without a dark mass."
      },
      {
        "stageId": "result",
        "mode": "winner-field-presence-plus-fragmented-remnants",
        "maxVisibleInstances": 96,
        "clusterPolicy": "victorious Carthaginian ring remains visible; Roman remnants stay fragmented and sparse",
        "purpose": "Prevent the winner-disappears failure and avoid a final row of identical tokens."
      }
    ]
  },
